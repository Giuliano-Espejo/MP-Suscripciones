# Copiar como backend/.env (ignorado por git) y completar. Sin MP_ACCESS_TOKEN el backend usa la pasarela demo.

# Access Token de prueba del USUARIO VENDEDOR de prueba
# (Tus integraciones > tu aplicacion > Credenciales de prueba, o credenciales de produccion del usuario vendedor de prueba).
MP_ACCESS_TOKEN=

# Clave secreta de Webhooks (Tus integraciones > Webhooks > Configurar notificaciones). Vacio = no se valida firma.
MP_WEBHOOK_SECRET=

# URL https publica a donde vuelve el socio despues de pagar (MP no acepta localhost).
MP_BACK_URL=https://www.mercadopago.com.ar

# PostgreSQL (opcional, estos son los valores por defecto de docker-compose)
# DB_URL=jdbc:postgresql://localhost:5432/subs
# DB_USER=subs
# DB_PASSWORD=subs
